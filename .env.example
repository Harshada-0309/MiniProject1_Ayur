# ==============================================================================
# AyurDiet Clinical Nutrition & Ayurvedic Diet Planning System
# Environment Configuration Template (Placeholder Values Only)
# ==============================================================================
# IMPORTANT: Copy this file to .env and provide your actual credentials.
# NEVER commit your real .env file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Full connection string (Render provides this as DATABASE_URL)
DATABASE_URL=postgresql://ayurdiet_user:your_secure_db_password@localhost:5432/ayurdiet_db

# Granular database parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=ayurdiet_user
DB_PASSWORD=your_secure_db_password
DB_NAME=ayurdiet_db

# ------------------------------------------------------------------------------
# 2. Node.js Backend Service
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters long.
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_key

# CORS and Origin Validation (comma-separated allowed origins)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Internal / Service Communication
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Python AI Service (FastAPI / Gemini / RAG)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
BACKEND_URL=http://localhost:5000

# Google Gemini API Key (Required for Phase 6 LLM generation; falls back to deterministic engine if absent)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. Frontend Application (React / Vite)
# ------------------------------------------------------------------------------
# Base API URL used by the browser client
VITE_API_URL=http://localhost:5000

